[{"start": 0.0, "end": 2.94, "text": "At exactly 12 o'clock, the sun disappears.", "words": [{"w": "At", "s": 0.0, "e": 0.24}, {"w": "exactly", "s": 0.24, "e": 0.74}, {"w": "12", "s": 0.74, "e": 1.08}, {"w": "o", "s": 1.08, "e": 1.14}, {"w": "'clock,", "s": 1.14, "e": 1.56}, {"w": "the", "s": 1.96, "e": 2.04}, {"w": "sun", "s": 2.04, "e": 2.26}, {"w": "disappears.", "s": 2.26, "e": 2.94}]}, {"start": 3.74, "end": 5.34, "text": "Milo is eating lunch on a park bench.", "words": [{"w": "Milo", "s": 3.74, "e": 3.76}, {"w": "is", "s": 3.76, "e": 3.98}, {"w": "eating", "s": 3.98, "e": 4.16}, {"w": "lunch", "s": 4.16, "e": 4.46}, {"w": "on", "s": 4.46, "e": 4.64}, {"w": "a", "s": 4.64, "e": 4.76}, {"w": "park", "s": 4.76, "e": 4.96}, {"w": "bench.", "s": 4.96, "e": 5.34}]}, {"start": 5.76, "end": 10.24, "text": "Birds are singing, the sky is blue, and for the next 8 minutes and 20 seconds,", "words": [{"w": "Birds", "s": 5.76, "e": 5.92}, {"w": "are", "s": 5.92, "e": 6.1}, {"w": "singing,", "s": 6.1, "e": 6.42}, {"w": "the", "s": 6.76, "e": 6.88}, {"w": "sky", "s": 6.88, "e": 7.18}, {"w": "is", "s": 7.18, "e": 7.38}, {"w": "blue,", "s": 7.38, "e": 7.68}, {"w": "and", "s": 8.02, "e": 8.14}, {"w": "for", "s": 8.14, "e": 8.28}, {"w": "the", "s": 8.28, "e": 8.4}, {"w": "next", "s": 8.4, "e": 8.64}, {"w": "8", "s": 8.64, "e": 8.92}, {"w": "minutes", "s": 8.92, "e": 9.2}, {"w": "and", "s": 9.2, "e": 9.46}, {"w": "20", "s": 9.46, "e": 9.78}, {"w": "seconds,", "s": 9.78, "e": 10.24}]}, {"start": 10.72, "end": 12.42, "text": "absolutely nothing will change.", "words": [{"w": "absolutely", "s": 10.72, "e": 11.16}, {"w": "nothing", "s": 11.16, "e": 11.68}, {"w": "will", "s": 11.68, "e": 12.04}, {"w": "change.", "s": 12.04, "e": 12.42}]}, {"start": 13.0, "end": 15.62, "text": "Not for Milo, not for anyone on Earth.", "words": [{"w": "Not", "s": 13.0, "e": 13.36}, {"w": "for", "s": 13.36, "e": 13.54}, {"w": "Milo,", "s": 13.54, "e": 13.86}, {"w": "not", "s": 14.32, "e": 14.5}, {"w": "for", "s": 14.5, "e": 14.7}, {"w": "anyone", "s": 14.7, "e": 15.12}, {"w": "on", "s": 15.12, "e": 15.38}, {"w": "Earth.", "s": 15.38, "e": 15.62}]}, {"start": 16.12, "end": 19.64, "text": "Because the sun is already gone, we just haven't been told yet.", "words": [{"w": "Because", "s": 16.12, "e": 16.48}, {"w": "the", "s": 16.48, "e": 16.7}, {"w": "sun", "s": 16.7, "e": 16.9}, {"w": "is", "s": 16.9, "e": 17.08}, {"w": "already", "s": 17.08, "e": 17.4}, {"w": "gone,", "s": 17.4, "e": 17.78}, {"w": "we", "s": 18.1, "e": 18.34}, {"w": "just", "s": 18.34, "e": 18.54}, {"w": "haven't", "s": 18.54, "e": 18.88}, {"w": "been", "s": 18.88, "e": 19.04}, {"w": "told", "s": 19.04, "e": 19.26}, {"w": "yet.", "s": 19.26, "e": 19.64}]}, {"start": 20.0, "end": 20.62, "text": "Here's why.", "words": [{"w": "Here's", "s": 20.0, "e": 20.28}, {"w": "why.", "s": 20.28, "e": 20.62}]}, {"start": 21.32, "end": 25.54, "text": "Sunlight takes about 8 minutes and 20 seconds to travel from the sun to us.", "words": [{"w": "Sunlight", "s": 21.32, "e": 21.72}, {"w": "takes", "s": 21.72, "e": 21.96}, {"w": "about", "s": 21.96, "e": 22.26}, {"w": "8", "s": 22.26, "e": 22.58}, {"w": "minutes", "s": 22.58, "e": 22.9}, {"w": "and", "s": 22.9, "e": 23.12}, {"w": "20", "s": 23.12, "e": 23.48}, {"w": "seconds", "s": 23.48, "e": 23.86}, {"w": "to", "s": 23.86, "e": 24.1}, {"w": "travel", "s": 24.1, "e": 24.36}, {"w": "from", "s": 24.36, "e": 24.62}, {"w": "the", "s": 24.62, "e": 24.78}, {"w": "sun", "s": 24.78, "e": 25.0}, {"w": "to", "s": 25.0, "e": 25.18}, {"w": "us.", "s": 25.18, "e": 25.54}]}, {"start": 25.54, "end": 30.42, "text": "So the light hitting Milo's face right now left the sun before it vanished.", "words": [{"w": "So", "s": 25.54, "e": 26.3}, {"w": "the", "s": 26.3, "e": 26.46}, {"w": "light", "s": 26.46, "e": 26.72}, {"w": "hitting", "s": 26.72, "e": 27.0}, {"w": "Milo's", "s": 27.0, "e": 27.52}, {"w": "face", "s": 27.52, "e": 27.72}, {"w": "right", "s": 27.72, "e": 28.02}, {"w": "now", "s": 28.02, "e": 28.4}, {"w": "left", "s": 28.4, "e": 28.86}, {"w": "the", "s": 28.86, "e": 29.12}, {"w": "sun", "s": 29.12, "e": 29.38}, {"w": "before", "s": 29.38, "e": 29.84}, {"w": "it", "s": 29.84, "e": 30.06}, {"w": "vanished.", "s": 30.06, "e": 30.42}]}, {"start": 31.32, "end": 33.26, "text": "It's like a letter from someone who's already gone.", "words": [{"w": "It's", "s": 31.32, "e": 31.38}, {"w": "like", "s": 31.38, "e": 31.5}, {"w": "a", "s": 31.5, "e": 31.64}, {"w": "letter", "s": 31.64, "e": 31.84}, {"w": "from", "s": 31.84, "e": 32.1}, {"w": "someone", "s": 32.1, "e": 32.42}, {"w": "who's", "s": 32.42, "e": 32.64}, {"w": "already", "s": 32.64, "e": 32.9}, {"w": "gone.", "s": 32.9, "e": 33.26}]}, {"start": 33.64, "end": 34.56, "text": "It's still in the mail.", "words": [{"w": "It's", "s": 33.64, "e": 33.88}, {"w": "still", "s": 33.88, "e": 34.04}, {"w": "in", "s": 34.04, "e": 34.18}, {"w": "the", "s": 34.18, "e": 34.28}, {"w": "mail.", "s": 34.28, "e": 34.56}]}, {"start": 35.02, "end": 36.2, "text": "And here's the strange part.", "words": [{"w": "And", "s": 35.02, "e": 35.1}, {"w": "here's", "s": 35.1, "e": 35.34}, {"w": "the", "s": 35.34, "e": 35.52}, {"w": "strange", "s": 35.52, "e": 35.78}, {"w": "part.", "s": 35.78, "e": 36.2}]}, {"start": 36.74, "end": 38.96, "text": "The sun's gravity is still in the mail too.", "words": [{"w": "The", "s": 36.74, "e": 36.9}, {"w": "sun's", "s": 36.9, "e": 37.26}, {"w": "gravity", "s": 37.26, "e": 37.58}, {"w": "is", "s": 37.58, "e": 37.8}, {"w": "still", "s": 37.8, "e": 38.08}, {"w": "in", "s": 38.08, "e": 38.24}, {"w": "the", "s": 38.24, "e": 38.36}, {"w": "mail", "s": 38.36, "e": 38.6}, {"w": "too.", "s": 38.6, "e": 38.96}]}, {"start": 39.58, "end": 43.16, "text": "For a long time, scientists argued about how fast gravity travels.", "words": [{"w": "For", "s": 39.58, "e": 39.68}, {"w": "a", "s": 39.68, "e": 39.82}, {"w": "long", "s": 39.82, "e": 40.02}, {"w": "time,", "s": 40.02, "e": 40.44}, {"w": "scientists", "s": 40.62, "e": 40.92}, {"w": "argued", "s": 40.92, "e": 41.38}, {"w": "about", "s": 41.38, "e": 41.68}, {"w": "how", "s": 41.68, "e": 41.9}, {"w": "fast", "s": 41.9, "e": 42.28}, {"w": "gravity", "s": 42.28, "e": 42.72}, {"w": "travels.", "s": 42.72, "e": 43.16}]}, {"start": 43.98, "end": 49.44, "text": "Then in 2017, two dead stars collided 130 million light years away.", "words": [{"w": "Then", "s": 43.98, "e": 44.2}, {"w": "in", "s": 44.2, "e": 44.36}, {"w": "2017,", "s": 44.36, "e": 45.2}, {"w": "two", "s": 45.6, "e": 45.84}, {"w": "dead", "s": 45.84, "e": 46.08}, {"w": "stars", "s": 46.08, "e": 46.48}, {"w": "collided", "s": 46.48, "e": 46.94}, {"w": "130", "s": 46.94, "e": 47.58}, {"w": "million", "s": 47.58, "e": 48.46}, {"w": "light", "s": 48.46, "e": 48.76}, {"w": "years", "s": 48.76, "e": 48.96}, {"w": "away.", "s": 48.96, "e": 49.44}]}, {"start": 50.04, "end": 51.64, "text": "Telescopes caught the flash of light,", "words": [{"w": "Telescopes", "s": 50.04, "e": 50.36}, {"w": "caught", "s": 50.36, "e": 50.62}, {"w": "the", "s": 50.62, "e": 50.82}, {"w": "flash", "s": 50.82, "e": 51.14}, {"w": "of", "s": 51.14, "e": 51.32}, {"w": "light,", "s": 51.32, "e": 51.64}]}, {"start": 51.94, "end": 55.14, "text": "and gravitational wave detectors caught the ripple in space.", "words": [{"w": "and", "s": 51.94, "e": 52.22}, {"w": "gravitational", "s": 52.22, "e": 52.72}, {"w": "wave", "s": 52.72, "e": 53.2}, {"w": "detectors", "s": 53.2, "e": 53.68}, {"w": "caught", "s": 53.68, "e": 54.1}, {"w": "the", "s": 54.1, "e": 54.28}, {"w": "ripple", "s": 54.28, "e": 54.5}, {"w": "in", "s": 54.5, "e": 54.74}, {"w": "space.", "s": 54.74, "e": 55.14}]}, {"start": 55.54, "end": 60.32, "text": "Less than 2 seconds apart, after a journey of 130 million years.", "words": [{"w": "Less", "s": 55.54, "e": 55.9}, {"w": "than", "s": 55.9, "e": 56.12}, {"w": "2", "s": 56.12, "e": 56.36}, {"w": "seconds", "s": 56.36, "e": 56.7}, {"w": "apart,", "s": 56.7, "e": 57.12}, {"w": "after", "s": 57.58, "e": 57.76}, {"w": "a", "s": 57.76, "e": 58.0}, {"w": "journey", "s": 58.0, "e": 58.22}, {"w": "of", "s": 58.22, "e": 58.46}, {"w": "130", "s": 58.46, "e": 59.28}, {"w": "million", "s": 59.28, "e": 59.68}, {"w": "years.", "s": 59.68, "e": 60.32}]}, {"start": 61.22, "end": 62.76, "text": "Gravity moves at the speed of light.", "words": [{"w": "Gravity", "s": 61.22, "e": 61.38}, {"w": "moves", "s": 61.38, "e": 61.74}, {"w": "at", "s": 61.74, "e": 61.96}, {"w": "the", "s": 61.96, "e": 62.1}, {"w": "speed", "s": 62.1, "e": 62.32}, {"w": "of", "s": 62.32, "e": 62.48}, {"w": "light.", "s": 62.48, "e": 62.76}]}, {"start": 63.16, "end": 66.94, "text": "So for 8 minutes, Earth keeps going around a sun that doesn't exist.", "words": [{"w": "So", "s": 63.16, "e": 63.28}, {"w": "for", "s": 63.28, "e": 63.5}, {"w": "8", "s": 63.5, "e": 63.78}, {"w": "minutes,", "s": 63.78, "e": 64.18}, {"w": "Earth", "s": 64.46, "e": 64.6}, {"w": "keeps", "s": 64.6, "e": 64.86}, {"w": "going", "s": 64.86, "e": 65.2}, {"w": "around", "s": 65.2, "e": 65.46}, {"w": "a", "s": 65.46, "e": 65.66}, {"w": "sun", "s": 65.66, "e": 65.86}, {"w": "that", "s": 65.86, "e": 66.1}, {"w": "doesn't", "s": 66.1, "e": 66.46}, {"w": "exist.", "s": 66.46, "e": 66.94}]}, {"start": 67.66, "end": 68.94, "text": "Milo keeps eating his sandwich.", "words": [{"w": "Milo", "s": 67.66, "e": 67.78}, {"w": "keeps", "s": 67.78, "e": 68.08}, {"w": "eating", "s": 68.08, "e": 68.36}, {"w": "his", "s": 68.36, "e": 68.56}, {"w": "sandwich.", "s": 68.56, "e": 68.94}]}, {"start": 69.32, "end": 72.04, "text": "His survival odds? 100%.", "words": [{"w": "His", "s": 69.32, "e": 69.46}, {"w": "survival", "s": 69.46, "e": 69.82}, {"w": "odds?", "s": 69.82, "e": 70.24}, {"w": "100%.", "s": 71.48, "e": 72.04}]}, {"start": 72.04, "end": 73.92, "text": "For now, remember the moon.", "words": [{"w": "For", "s": 72.04, "e": 72.44}, {"w": "now,", "s": 72.44, "e": 72.72}, {"w": "remember", "s": 73.16, "e": 73.44}, {"w": "the", "s": 73.44, "e": 73.68}, {"w": "moon.", "s": 73.68, "e": 73.92}]}, {"start": 74.28, "end": 75.2, "text": "It's about to matter.", "words": [{"w": "It's", "s": 74.28, "e": 74.48}, {"w": "about", "s": 74.48, "e": 74.7}, {"w": "to", "s": 74.7, "e": 74.9}, {"w": "matter.", "s": 74.9, "e": 75.2}]}, {"start": 75.74, "end": 76.24, "text": "1208.", "words": [{"w": "1208.", "s": 75.74, "e": 76.24}]}, {"start": 76.68, "end": 77.32, "text": "20 seconds.", "words": [{"w": "20", "s": 76.68, "e": 76.92}, {"w": "seconds.", "s": 76.92, "e": 77.32}]}, {"start": 78.0, "end": 81.18, "text": "The sky goes out, not slowly, like a sunset.", "words": [{"w": "The", "s": 78.0, "e": 78.22}, {"w": "sky", "s": 78.22, "e": 78.48}, {"w": "goes", "s": 78.48, "e": 78.72}, {"w": "out,", "s": 78.72, "e": 79.12}, {"w": "not", "s": 79.38, "e": 79.62}, {"w": "slowly,", "s": 79.62, "e": 80.08}, {"w": "like", "s": 80.48, "e": 80.68}, {"w": "a", "s": 80.68, "e": 80.82}, {"w": "sunset.", "s": 80.82, "e": 81.18}]}, {"start": 81.82, "end": 84.66, "text": "All at once, everywhere on the day side of the planet.", "words": [{"w": "All", "s": 81.82, "e": 82.08}, {"w": "at", "s": 82.08, "e": 82.24}, {"w": "once,", "s": 82.24, "e": 82.62}, {"w": "everywhere", "s": 82.9, "e": 83.2}, {"w": "on", "s": 83.2, "e": 83.54}, {"w": "the", "s": 83.54, "e": 83.7}, {"w": "day", "s": 83.7, "e": 83.86}, {"w": "side", "s": 83.86, "e": 84.12}, {"w": "of", "s": 84.12, "e": 84.26}, {"w": "the", "s": 84.26, "e": 84.38}, {"w": "planet.", "s": 84.38, "e": 84.66}]}, {"start": 84.66, "end": 86.3, "text": "Like someone hit a switch.", "words": [{"w": "Like", "s": 84.66, "e": 85.3}, {"w": "someone", "s": 85.3, "e": 85.66}, {"w": "hit", "s": 85.66, "e": 85.86}, {"w": "a", "s": 85.86, "e": 86.0}, {"w": "switch.", "s": 86.0, "e": 86.3}]}, {"start": 86.86, "end": 88.06, "text": "The blue sky turns black,", "words": [{"w": "The", "s": 86.86, "e": 86.88}, {"w": "blue", "s": 86.88, "e": 87.06}, {"w": "sky", "s": 87.06, "e": 87.32}, {"w": "turns", "s": 87.32, "e": 87.62}, {"w": "black,", "s": 87.62, "e": 88.06}]}, {"start": 88.4, "end": 91.46, "text": "because blue sky is just sunlight bouncing around in the air.", "words": [{"w": "because", "s": 88.4, "e": 88.7}, {"w": "blue", "s": 88.7, "e": 88.98}, {"w": "sky", "s": 88.98, "e": 89.28}, {"w": "is", "s": 89.28, "e": 89.48}, {"w": "just", "s": 89.48, "e": 89.68}, {"w": "sunlight", "s": 89.68, "e": 90.1}, {"w": "bouncing", "s": 90.1, "e": 90.5}, {"w": "around", "s": 90.5, "e": 90.86}, {"w": "in", "s": 90.86, "e": 91.06}, {"w": "the", "s": 91.06, "e": 91.18}, {"w": "air.", "s": 91.18, "e": 91.46}]}, {"start": 91.86, "end": 93.4, "text": "No sunlight, no blue.", "words": [{"w": "No", "s": 91.86, "e": 91.98}, {"w": "sunlight,", "s": 91.98, "e": 92.5}, {"w": "no", "s": 92.82, "e": 93.06}, {"w": "blue.", "s": 93.06, "e": 93.4}]}, {"start": 94.12, "end": 96.72, "text": "And in that same moment, Earth lets go.", "words": [{"w": "And", "s": 94.12, "e": 94.24}, {"w": "in", "s": 94.24, "e": 94.36}, {"w": "that", "s": 94.36, "e": 94.54}, {"w": "same", "s": 94.54, "e": 94.88}, {"w": "moment,", "s": 94.88, "e": 95.32}, {"w": "Earth", "s": 95.8, "e": 95.98}, {"w": "lets", "s": 95.98, "e": 96.34}, {"w": "go.", "s": 96.34, "e": 96.72}]}, {"start": 97.24, "end": 101.1, "text": "The pole that kept us circling for 4.5 billion years is gone.", "words": [{"w": "The", "s": 97.24, "e": 97.5}, {"w": "pole", "s": 97.5, "e": 97.72}, {"w": "that", "s": 97.72, "e": 97.92}, {"w": "kept", "s": 97.92, "e": 98.12}, {"w": "us", "s": 98.12, "e": 98.34}, {"w": "circling", "s": 98.34, "e": 98.66}, {"w": "for", "s": 98.66, "e": 98.94}, {"w": "4", "s": 98.94, "e": 99.28}, {"w": ".5", "s": 99.28, "e": 99.72}, {"w": "billion", "s": 99.72, "e": 100.02}, {"w": "years", "s": 100.02, "e": 100.5}, {"w": "is", "s": 100.5, "e": 100.76}, {"w": "gone.", "s": 100.76, "e": 101.1}]}, {"start": 101.6, "end": 103.86, "text": "And the planet flies off in a straight line,", "words": [{"w": "And", "s": 101.6, "e": 101.82}, {"w": "the", "s": 101.82, "e": 101.96}, {"w": "planet", "s": 101.96, "e": 102.24}, {"w": "flies", "s": 102.24, "e": 102.58}, {"w": "off", "s": 102.58, "e": 102.96}, {"w": "in", "s": 102.96, "e": 103.12}, {"w": "a", "s": 103.12, "e": 103.26}, {"w": "straight", "s": 103.26, "e": 103.5}, {"w": "line,", "s": 103.5, "e": 103.86}]}, {"start": 104.28, "end": 106.32, "text": "at about 30 kilometers every second.", "words": [{"w": "at", "s": 104.28, "e": 104.42}, {"w": "about", "s": 104.42, "e": 104.66}, {"w": "30", "s": 104.66, "e": 105.04}, {"w": "kilometers", "s": 105.04, "e": 105.42}, {"w": "every", "s": 105.42, "e": 105.86}, {"w": "second.", "s": 105.86, "e": 106.32}]}, {"start": 107.14, "end": 107.92, "text": "Milo feels nothing.", "words": [{"w": "Milo", "s": 107.14, "e": 107.22}, {"w": "feels", "s": 107.22, "e": 107.56}, {"w": "nothing.", "s": 107.56, "e": 107.92}]}, {"start": 108.38, "end": 109.96, "text": "No shaking, no wind.", "words": [{"w": "No", "s": 108.38, "e": 108.64}, {"w": "shaking,", "s": 108.64, "e": 108.96}, {"w": "no", "s": 109.42, "e": 109.64}, {"w": "wind.", "s": 109.64, "e": 109.96}]}, {"start": 110.56, "end": 112.46, "text": "Everything around him is flying with him.", "words": [{"w": "Everything", "s": 110.56, "e": 110.86}, {"w": "around", "s": 110.86, "e": 111.22}, {"w": "him", "s": 111.22, "e": 111.46}, {"w": "is", "s": 111.46, "e": 111.6}, {"w": "flying", "s": 111.6, "e": 111.92}, {"w": "with", "s": 111.92, "e": 112.18}, {"w": "him.", "s": 112.18, "e": 112.46}]}, {"start": 112.46, "end": 116.24, "text": "Then, about one second later, the moon goes dark.", "words": [{"w": "Then,", "s": 112.46, "e": 113.14}, {"w": "about", "s": 113.36, "e": 113.62}, {"w": "one", "s": 113.62, "e": 114.0}, {"w": "second", "s": 114.0, "e": 114.3}, {"w": "later,", "s": 114.3, "e": 114.74}, {"w": "the", "s": 115.14, "e": 115.22}, {"w": "moon", "s": 115.22, "e": 115.48}, {"w": "goes", "s": 115.48, "e": 115.86}, {"w": "dark.", "s": 115.86, "e": 116.24}]}, {"start": 116.9, "end": 118.56, "text": "The moon doesn't make its own light.", "words": [{"w": "The", "s": 116.9, "e": 117.12}, {"w": "moon", "s": 117.12, "e": 117.34}, {"w": "doesn't", "s": 117.34, "e": 117.66}, {"w": "make", "s": 117.66, "e": 117.86}, {"w": "its", "s": 117.86, "e": 118.04}, {"w": "own", "s": 118.04, "e": 118.22}, {"w": "light.", "s": 118.22, "e": 118.56}]}, {"start": 118.86, "end": 120.06, "text": "It's a mirror for the Sunday.", "words": [{"w": "It's", "s": 118.86, "e": 119.08}, {"w": "a", "s": 119.08, "e": 119.22}, {"w": "mirror", "s": 119.22, "e": 119.4}, {"w": "for", "s": 119.4, "e": 119.62}, {"w": "the", "s": 119.62, "e": 119.76}, {"w": "Sunday.", "s": 119.76, "e": 120.06}]}, {"start": 120.38, "end": 123.98, "text": "Its last reflected sunlight takes just over a second to reach Earth.", "words": [{"w": "Its", "s": 120.38, "e": 120.58}, {"w": "last", "s": 120.58, "e": 120.9}, {"w": "reflected", "s": 120.9, "e": 121.42}, {"w": "sunlight", "s": 121.42, "e": 121.88}, {"w": "takes", "s": 121.88, "e": 122.16}, {"w": "just", "s": 122.16, "e": 122.54}, {"w": "over", "s": 122.54, "e": 122.8}, {"w": "a", "s": 122.8, "e": 123.0}, {"w": "second", "s": 123.0, "e": 123.2}, {"w": "to", "s": 123.2, "e": 123.48}, {"w": "reach", "s": 123.48, "e": 123.68}, {"w": "Earth.", "s": 123.68, "e": 123.98}]}, {"start": 124.34, "end": 125.94, "text": "And then the mirror goes blank too.", "words": [{"w": "And", "s": 124.34, "e": 124.46}, {"w": "then", "s": 124.46, "e": 124.6}, {"w": "the", "s": 124.6, "e": 124.76}, {"w": "mirror", "s": 124.76, "e": 125.0}, {"w": "goes", "s": 125.0, "e": 125.3}, {"w": "blank", "s": 125.3, "e": 125.58}, {"w": "too.", "s": 125.58, "e": 125.94}]}, {"start": 126.54, "end": 128.6, "text": "Milo's odds just dropped to 90%.", "words": [{"w": "Milo's", "s": 126.54, "e": 126.8}, {"w": "odds", "s": 126.8, "e": 126.96}, {"w": "just", "s": 126.96, "e": 127.3}, {"w": "dropped", "s": 127.3, "e": 127.56}, {"w": "to", "s": 127.56, "e": 127.8}, {"w": "90%.", "s": 127.8, "e": 128.6}]}, {"start": 128.6, "end": 130.46, "text": "And he doesn't even know why yet.", "words": [{"w": "And", "s": 128.6, "e": 129.16}, {"w": "he", "s": 129.16, "e": 129.28}, {"w": "doesn't", "s": 129.28, "e": 129.52}, {"w": "even", "s": 129.52, "e": 129.68}, {"w": "know", "s": 129.68, "e": 129.9}, {"w": "why", "s": 129.9, "e": 130.16}, {"w": "yet.", "s": 130.16, "e": 130.46}]}, {"start": 131.06, "end": 131.72, "text": "But look up.", "words": [{"w": "But", "s": 131.06, "e": 131.26}, {"w": "look", "s": 131.26, "e": 131.44}, {"w": "up.", "s": 131.44, "e": 131.72}]}, {"start": 132.32, "end": 134.04, "text": "The stars are out, at noon.", "words": [{"w": "The", "s": 132.32, "e": 132.46}, {"w": "stars", "s": 132.46, "e": 132.76}, {"w": "are", "s": 132.76, "e": 133.0}, {"w": "out,", "s": 133.0, "e": 133.3}, {"w": "at", "s": 133.58, "e": 133.74}, {"w": "noon.", "s": 133.74, "e": 134.04}]}, {"start": 134.6, "end": 136.8, "text": "More stars than Milo has ever seen,", "words": [{"w": "More", "s": 134.6, "e": 134.84}, {"w": "stars", "s": 134.84, "e": 135.16}, {"w": "than", "s": 135.16, "e": 135.44}, {"w": "Milo", "s": 135.44, "e": 135.76}, {"w": "has", "s": 135.76, "e": 136.02}, {"w": "ever", "s": 136.02, "e": 136.38}, {"w": "seen,", "s": 136.38, "e": 136.8}]}, {"start": 137.1, "end": 139.44, "text": "because there's no sunlight washing them away.", "words": [{"w": "because", "s": 137.1, "e": 137.5}, {"w": "there's", "s": 137.5, "e": 137.76}, {"w": "no", "s": 137.76, "e": 137.98}, {"w": "sunlight", "s": 137.98, "e": 138.48}, {"w": "washing", "s": 138.48, "e": 138.86}, {"w": "them", "s": 138.86, "e": 139.12}, {"w": "away.", "s": 139.12, "e": 139.44}]}, {"start": 140.02, "end": 141.86, "text": "And one of them is brighter than the rest.", "words": [{"w": "And", "s": 140.02, "e": 140.24}, {"w": "one", "s": 140.24, "e": 140.44}, {"w": "of", "s": 140.44, "e": 140.6}, {"w": "them", "s": 140.6, "e": 140.72}, {"w": "is", "s": 140.72, "e": 140.92}, {"w": "brighter", "s": 140.92, "e": 141.18}, {"w": "than", "s": 141.18, "e": 141.44}, {"w": "the", "s": 141.44, "e": 141.58}, {"w": "rest.", "s": 141.58, "e": 141.86}]}, {"start": 142.46, "end": 143.28, "text": "That's Jupiter.", "words": [{"w": "That's", "s": 142.46, "e": 142.98}, {"w": "Jupiter.", "s": 142.98, "e": 143.28}]}, {"start": 143.68, "end": 144.48, "text": "It's still shining.", "words": [{"w": "It's", "s": 143.68, "e": 143.9}, {"w": "still", "s": 143.9, "e": 144.12}, {"w": "shining.", "s": 144.12, "e": 144.48}]}, {"start": 145.1, "end": 148.66, "text": "Because the last sunlight that hit Jupiter is still on its way to us.", "words": [{"w": "Because", "s": 145.1, "e": 145.34}, {"w": "the", "s": 145.34, "e": 145.54}, {"w": "last", "s": 145.54, "e": 145.78}, {"w": "sunlight", "s": 145.78, "e": 146.2}, {"w": "that", "s": 146.2, "e": 146.42}, {"w": "hit", "s": 146.42, "e": 146.58}, {"w": "Jupiter", "s": 146.58, "e": 147.0}, {"w": "is", "s": 147.0, "e": 147.32}, {"w": "still", "s": 147.32, "e": 147.6}, {"w": "on", "s": 147.6, "e": 147.8}, {"w": "its", "s": 147.8, "e": 147.92}, {"w": "way", "s": 147.92, "e": 148.14}, {"w": "to", "s": 148.14, "e": 148.28}, {"w": "us.", "s": 148.28, "e": 148.66}]}, {"start": 148.82, "end": 151.16, "text": "For somewhere between half an hour and an hour,", "words": [{"w": "For", "s": 148.82, "e": 149.02}, {"w": "somewhere", "s": 149.02, "e": 149.34}, {"w": "between", "s": 149.34, "e": 149.7}, {"w": "half", "s": 149.7, "e": 150.0}, {"w": "an", "s": 150.0, "e": 150.18}, {"w": "hour", "s": 150.18, "e": 150.4}, {"w": "and", "s": 150.4, "e": 150.7}, {"w": "an", "s": 150.7, "e": 150.84}, {"w": "hour,", "s": 150.84, "e": 151.16}]}, {"start": 151.44, "end": 154.1, "text": "the last sunlight in the universe that we will ever see", "words": [{"w": "the", "s": 151.44, "e": 151.6}, {"w": "last", "s": 151.6, "e": 151.88}, {"w": "sunlight", "s": 151.88, "e": 152.3}, {"w": "in", "s": 152.3, "e": 152.46}, {"w": "the", "s": 152.46, "e": 152.58}, {"w": "universe", "s": 152.58, "e": 152.94}, {"w": "that", "s": 152.94, "e": 153.18}, {"w": "we", "s": 153.18, "e": 153.3}, {"w": "will", "s": 153.3, "e": 153.46}, {"w": "ever", "s": 153.46, "e": 153.76}, {"w": "see", "s": 153.76, "e": 154.1}]}, {"start": 154.1, "end": 156.54, "text": "is bouncing back to us off a giant planet.", "words": [{"w": "is", "s": 154.1, "e": 154.48}, {"w": "bouncing", "s": 154.48, "e": 154.8}, {"w": "back", "s": 154.8, "e": 155.14}, {"w": "to", "s": 155.14, "e": 155.32}, {"w": "us", "s": 155.32, "e": 155.52}, {"w": "off", "s": 155.52, "e": 155.68}, {"w": "a", "s": 155.68, "e": 155.9}, {"w": "giant", "s": 155.9, "e": 156.14}, {"w": "planet.", "s": 156.14, "e": 156.54}]}, {"start": 157.22, "end": 158.76, "text": "Then Jupiter goes dark too.", "words": [{"w": "Then", "s": 157.22, "e": 157.46}, {"w": "Jupiter", "s": 157.46, "e": 157.82}, {"w": "goes", "s": 157.82, "e": 158.1}, {"w": "dark", "s": 158.1, "e": 158.44}, {"w": "too.", "s": 158.44, "e": 158.76}]}, {"start": 159.44, "end": 162.46, "text": "Now it's just Milo, a black sky, and a clock.", "words": [{"w": "Now", "s": 159.44, "e": 159.64}, {"w": "it's", "s": 159.64, "e": 159.9}, {"w": "just", "s": 159.9, "e": 160.1}, {"w": "Milo,", "s": 160.1, "e": 160.4}, {"w": "a", "s": 160.82, "e": 160.98}, {"w": "black", "s": 160.98, "e": 161.2}, {"w": "sky,", "s": 161.2, "e": 161.6}, {"w": "and", "s": 161.9, "e": 162.06}, {"w": "a", "s": 162.06, "e": 162.36}, {"w": "clock.", "s": 162.36, "e": 162.46}]}, {"start": 163.0, "end": 163.5, "text": "Day one.", "words": [{"w": "Day", "s": 163.0, "e": 163.08}, {"w": "one.", "s": 163.08, "e": 163.5}]}, {"start": 164.24, "end": 166.92, "text": "The first thing Milo notices isn't the dark.", "words": [{"w": "The", "s": 164.24, "e": 164.42}, {"w": "first", "s": 164.42, "e": 164.68}, {"w": "thing", "s": 164.68, "e": 164.98}, {"w": "Milo", "s": 164.98, "e": 165.3}, {"w": "notices", "s": 165.3, "e": 165.82}, {"w": "isn't", "s": 165.82, "e": 166.44}, {"w": "the", "s": 166.44, "e": 166.58}, {"w": "dark.", "s": 166.58, "e": 166.92}]}, {"start": 167.28, "end": 168.14, "text": "It's the silence.", "words": [{"w": "It's", "s": 167.28, "e": 167.52}, {"w": "the", "s": 167.52, "e": 167.7}, {"w": "silence.", "s": 167.7, "e": 168.14}]}, {"start": 169.18, "end": 170.26, "text": "Birds go quiet at night.", "words": [{"w": "Birds", "s": 169.18, "e": 169.18}, {"w": "go", "s": 169.18, "e": 169.46}, {"w": "quiet", "s": 169.46, "e": 169.8}, {"w": "at", "s": 169.8, "e": 169.98}, {"w": "night.", "s": 169.98, "e": 170.26}]}, {"start": 170.54, "end": 172.16, "text": "And as far as their bodies can tell,", "words": [{"w": "And", "s": 170.54, "e": 170.66}, {"w": "as", "s": 170.66, "e": 170.8}, {"w": "far", "s": 170.8, "e": 171.02}, {"w": "as", "s": 171.02, "e": 171.18}, {"w": "their", "s": 171.18, "e": 171.32}, {"w": "bodies", "s": 171.32, "e": 171.58}, {"w": "can", "s": 171.58, "e": 171.86}, {"w": "tell,", "s": 171.86, "e": 172.16}]}, {"start": 172.16, "end": 173.48, "text": "it's night now.", "words": [{"w": "it's", "s": 172.16, "e": 172.72}, {"w": "night", "s": 172.72, "e": 172.94}, {"w": "now.", "s": 172.94, "e": 173.48}]}, {"start": 173.76, "end": 174.04, "text": "Forever.", "words": [{"w": "Forever.", "s": 173.76, "e": 174.04}]}, {"start": 174.84, "end": 177.64, "text": "Every plant on Earth stops making food at the same moment.", "words": [{"w": "Every", "s": 174.84, "e": 175.04}, {"w": "plant", "s": 175.04, "e": 175.32}, {"w": "on", "s": 175.32, "e": 175.5}, {"w": "Earth", "s": 175.5, "e": 175.66}, {"w": "stops", "s": 175.66, "e": 176.04}, {"w": "making", "s": 176.04, "e": 176.38}, {"w": "food", "s": 176.38, "e": 176.68}, {"w": "at", "s": 176.68, "e": 176.82}, {"w": "the", "s": 176.82, "e": 176.98}, {"w": "same", "s": 176.98, "e": 177.22}, {"w": "moment.", "s": 177.22, "e": 177.64}]}, {"start": 178.3, "end": 179.62, "text": "Photosynthesis needs light.", "words": [{"w": "Photosynthesis", "s": 178.3, "e": 178.86}, {"w": "needs", "s": 178.86, "e": 179.24}, {"w": "light.", "s": 179.24, "e": 179.62}]}, {"start": 180.1, "end": 181.46, "text": "No light, no food.", "words": [{"w": "No", "s": 180.1, "e": 180.34}, {"w": "light,", "s": 180.34, "e": 180.66}, {"w": "no", "s": 180.88, "e": 181.1}, {"w": "food.", "s": 181.1, "e": 181.46}]}, {"start": 181.98, "end": 183.7, "text": "Most plants will be dead in a few weeks.", "words": [{"w": "Most", "s": 181.98, "e": 182.18}, {"w": "plants", "s": 182.18, "e": 182.44}, {"w": "will", "s": 182.44, "e": 182.6}, {"w": "be", "s": 182.6, "e": 182.72}, {"w": "dead", "s": 182.72, "e": 182.94}, {"w": "in", "s": 182.94, "e": 183.08}, {"w": "a", "s": 183.08, "e": 183.2}, {"w": "few", "s": 183.2, "e": 183.36}, {"w": "weeks.", "s": 183.36, "e": 183.7}]}, {"start": 184.42, "end": 185.3, "text": "But here's a surprise.", "words": [{"w": "But", "s": 184.42, "e": 184.54}, {"w": "here's", "s": 184.54, "e": 184.76}, {"w": "a", "s": 184.76, "e": 184.94}, {"w": "surprise.", "s": 184.94, "e": 185.3}]}, {"start": 186.12, "end": 188.08, "text": "Big old trees won't die that fast.", "words": [{"w": "Big", "s": 186.12, "e": 186.24}, {"w": "old", "s": 186.24, "e": 186.42}, {"w": "trees", "s": 186.42, "e": 186.78}, {"w": "won't", "s": 186.78, "e": 187.24}, {"w": "die", "s": 187.24, "e": 187.42}, {"w": "that", "s": 187.42, "e": 187.6}, {"w": "fast.", "s": 187.6, "e": 188.08}]}, {"start": 188.6, "end": 191.26, "text": "They grow slowly and store huge amounts of sugar.", "words": [{"w": "They", "s": 188.6, "e": 188.74}, {"w": "grow", "s": 188.74, "e": 188.96}, {"w": "slowly", "s": 188.96, "e": 189.5}, {"w": "and", "s": 189.5, "e": 189.78}, {"w": "store", "s": 189.78, "e": 190.04}, {"w": "huge", "s": 190.04, "e": 190.38}, {"w": "amounts", "s": 190.38, "e": 190.7}, {"w": "of", "s": 190.7, "e": 190.98}, {"w": "sugar.", "s": 190.98, "e": 191.26}]}, {"start": 191.8, "end": 193.36, "text": "And some could hang on for years,", "words": [{"w": "And", "s": 191.8, "e": 191.98}, {"w": "some", "s": 191.98, "e": 192.22}, {"w": "could", "s": 192.22, "e": 192.42}, {"w": "hang", "s": 192.42, "e": 192.58}, {"w": "on", "s": 192.58, "e": 192.78}, {"w": "for", "s": 192.78, "e": 193.0}, {"w": "years,", "s": 193.0, "e": 193.36}]}, {"start": 193.88, "end": 196.42, "text": "maybe decades, slowly eating themselves.", "words": [{"w": "maybe", "s": 193.88, "e": 194.1}, {"w": "decades,", "s": 194.1, "e": 194.76}, {"w": "slowly", "s": 195.3, "e": 195.48}, {"w": "eating", "s": 195.48, "e": 195.84}, {"w": "themselves.", "s": 195.84, "e": 196.42}]}, {"start": 196.98, "end": 198.34, "text": "Animals aren't so lucky.", "words": [{"w": "Animals", "s": 196.98, "e": 197.4}, {"w": "aren't", "s": 197.4, "e": 197.82}, {"w": "so", "s": 197.82, "e": 198.02}, {"w": "lucky.", "s": 198.02, "e": 198.34}]}, {"start": 198.82, "end": 200.42, "text": "Plant eaters run out of food first.", "words": [{"w": "Plant", "s": 198.82, "e": 198.88}, {"w": "eaters", "s": 198.88, "e": 199.24}, {"w": "run", "s": 199.24, "e": 199.5}, {"w": "out", "s": 199.5, "e": 199.66}, {"w": "of", "s": 199.66, "e": 199.78}, {"w": "food", "s": 199.78, "e": 199.98}, {"w": "first.", "s": 199.98, "e": 200.42}]}, {"start": 200.42, "end": 202.1, "text": "Then the animals that eat them.", "words": [{"w": "Then", "s": 200.42, "e": 200.9}, {"w": "the", "s": 200.9, "e": 201.08}, {"w": "animals", "s": 201.08, "e": 201.42}, {"w": "that", "s": 201.42, "e": 201.6}, {"w": "eat", "s": 201.6, "e": 201.8}, {"w": "them.", "s": 201.8, "e": 202.1}]}, {"start": 202.62, "end": 203.08, "text": "Milo's odds?", "words": [{"w": "Milo's", "s": 202.62, "e": 202.88}, {"w": "odds?", "s": 202.88, "e": 203.08}]}, {"start": 204.3, "end": 204.9, "text": "70%.", "words": [{"w": "70%.", "s": 204.3, "e": 204.9}]}, {"start": 204.9, "end": 205.58, "text": "Day seven.", "words": [{"w": "Day", "s": 204.9, "e": 205.18}, {"w": "seven.", "s": 205.18, "e": 205.58}]}, {"start": 206.12, "end": 208.18, "text": "The heat that's left is leaking out into space,", "words": [{"w": "The", "s": 206.12, "e": 206.12}, {"w": "heat", "s": 206.12, "e": 206.3}, {"w": "that's", "s": 206.3, "e": 206.6}, {"w": "left", "s": 206.6, "e": 206.82}, {"w": "is", "s": 206.82, "e": 207.0}, {"w": "leaking", "s": 207.0, "e": 207.3}, {"w": "out", "s": 207.3, "e": 207.62}, {"w": "into", "s": 207.62, "e": 207.84}, {"w": "space,", "s": 207.84, "e": 208.18}]}, {"start": 208.68, "end": 210.18, "text": "and there's nothing to replace it.", "words": [{"w": "and", "s": 208.68, "e": 208.7}, {"w": "there's", "s": 208.7, "e": 208.98}, {"w": "nothing", "s": 208.98, "e": 209.2}, {"w": "to", "s": 209.2, "e": 209.44}, {"w": "replace", "s": 209.44, "e": 209.76}, {"w": "it.", "s": 209.76, "e": 210.18}]}, {"start": 210.88, "end": 211.76, "text": "Within the first week,", "words": [{"w": "Within", "s": 210.88, "e": 210.98}, {"w": "the", "s": 210.98, "e": 211.2}, {"w": "first", "s": 211.2, "e": 211.44}, {"w": "week,", "s": 211.44, "e": 211.76}]}, {"start": 211.96, "end": 214.08, "text": "the average temperature on the surface of the planet", "words": [{"w": "the", "s": 211.96, "e": 212.04}, {"w": "average", "s": 212.04, "e": 212.34}, {"w": "temperature", "s": 212.34, "e": 212.76}, {"w": "on", "s": 212.76, "e": 213.0}, {"w": "the", "s": 213.0, "e": 213.14}, {"w": "surface", "s": 213.14, "e": 213.38}, {"w": "of", "s": 213.38, "e": 213.6}, {"w": "the", "s": 213.6, "e": 213.74}, {"w": "planet", "s": 213.74, "e": 214.08}]}, {"start": 214.08, "end": 216.94, "text": "drops to around minus 18 degrees Celsius.", "words": [{"w": "drops", "s": 214.08, "e": 214.5}, {"w": "to", "s": 214.5, "e": 214.78}, {"w": "around", "s": 214.78, "e": 215.08}, {"w": "minus", "s": 215.08, "e": 215.48}, {"w": "18", "s": 215.48, "e": 216.02}, {"w": "degrees", "s": 216.02, "e": 216.38}, {"w": "Celsius.", "s": 216.38, "e": 216.94}]}, {"start": 217.48, "end": 218.66, "text": "Colder than a home freezer.", "words": [{"w": "Colder", "s": 217.48, "e": 217.78}, {"w": "than", "s": 217.78, "e": 217.9}, {"w": "a", "s": 217.9, "e": 218.02}, {"w": "home", "s": 218.02, "e": 218.22}, {"w": "freezer.", "s": 218.22, "e": 218.66}]}, {"start": 219.1, "end": 219.48, "text": "Everywhere.", "words": [{"w": "Everywhere.", "s": 219.1, "e": 219.48}]}, {"start": 220.14, "end": 222.36, "text": "Including the places that have never seen snow.", "words": [{"w": "Including", "s": 220.14, "e": 220.44}, {"w": "the", "s": 220.44, "e": 220.68}, {"w": "places", "s": 220.68, "e": 220.98}, {"w": "that", "s": 220.98, "e": 221.26}, {"w": "have", "s": 221.26, "e": 221.4}, {"w": "never", "s": 221.4, "e": 221.64}, {"w": "seen", "s": 221.64, "e": 221.94}, {"w": "snow.", "s": 221.94, "e": 222.36}]}, {"start": 222.9, "end": 223.5, "text": "Milo's odds?", "words": [{"w": "Milo's", "s": 222.9, "e": 223.28}, {"w": "odds?", "s": 223.28, "e": 223.5}]}, {"start": 224.46, "end": 225.06, "text": "40%.", "words": [{"w": "40%.", "s": 224.46, "e": 225.06}]}, {"start": 225.06, "end": 225.98, "text": "Month two.", "words": [{"w": "Month", "s": 225.06, "e": 225.56}, {"w": "two.", "s": 225.56, "e": 225.98}]}, {"start": 226.5, "end": 228.06, "text": "The top of the ocean is freezing.", "words": [{"w": "The", "s": 226.5, "e": 226.74}, {"w": "top", "s": 226.74, "e": 226.96}, {"w": "of", "s": 226.96, "e": 227.1}, {"w": "the", "s": 227.1, "e": 227.2}, {"w": "ocean", "s": 227.2, "e": 227.42}, {"w": "is", "s": 227.42, "e": 227.66}, {"w": "freezing.", "s": 227.66, "e": 228.06}]}, {"start": 228.06, "end": 230.72, "text": "But this is where the planet does something clever.", "words": [{"w": "But", "s": 228.06, "e": 228.74}, {"w": "this", "s": 228.74, "e": 228.96}, {"w": "is", "s": 228.96, "e": 229.08}, {"w": "where", "s": 229.08, "e": 229.26}, {"w": "the", "s": 229.26, "e": 229.42}, {"w": "planet", "s": 229.42, "e": 229.66}, {"w": "does", "s": 229.66, "e": 229.96}, {"w": "something", "s": 229.96, "e": 230.3}, {"w": "clever.", "s": 230.3, "e": 230.72}]}, {"start": 231.44, "end": 231.92, "text": "Ice floats.", "words": [{"w": "Ice", "s": 231.44, "e": 231.52}, {"w": "floats.", "s": 231.52, "e": 231.92}]}, {"start": 232.54, "end": 233.6, "text": "And ice is a blanket.", "words": [{"w": "And", "s": 232.54, "e": 232.7}, {"w": "ice", "s": 232.7, "e": 232.96}, {"w": "is", "s": 232.96, "e": 233.14}, {"w": "a", "s": 233.14, "e": 233.26}, {"w": "blanket.", "s": 233.26, "e": 233.6}]}, {"start": 234.32, "end": 236.52, "text": "A thick lid of ice traps the heat underneath.", "words": [{"w": "A", "s": 234.32, "e": 234.52}, {"w": "thick", "s": 234.52, "e": 234.76}, {"w": "lid", "s": 234.76, "e": 234.94}, {"w": "of", "s": 234.94, "e": 235.1}, {"w": "ice", "s": 235.1, "e": 235.32}, {"w": "traps", "s": 235.32, "e": 235.66}, {"w": "the", "s": 235.66, "e": 235.9}, {"w": "heat", "s": 235.9, "e": 236.1}, {"w": "underneath.", "s": 236.1, "e": 236.52}]}, {"start": 237.18, "end": 238.92, "text": "And the deep ocean stays liquid.", "words": [{"w": "And", "s": 237.18, "e": 237.3}, {"w": "the", "s": 237.3, "e": 237.42}, {"w": "deep", "s": 237.42, "e": 237.68}, {"w": "ocean", "s": 237.68, "e": 238.02}, {"w": "stays", "s": 238.02, "e": 238.44}, {"w": "liquid.", "s": 238.44, "e": 238.92}]}, {"start": 239.4, "end": 240.2, "text": "Not for weeks.", "words": [{"w": "Not", "s": 239.4, "e": 239.68}, {"w": "for", "s": 239.68, "e": 239.88}, {"w": "weeks.", "s": 239.88, "e": 240.2}]}, {"start": 240.8, "end": 242.92, "text": "For a very, very long time.", "words": [{"w": "For", "s": 240.8, "e": 241.0}, {"w": "a", "s": 241.0, "e": 241.18}, {"w": "very,", "s": 241.18, "e": 241.62}, {"w": "very", "s": 242.02, "e": 242.12}, {"w": "long", "s": 242.12, "e": 242.48}, {"w": "time.", "s": 242.48, "e": 242.92}]}, {"start": 243.26, "end": 245.6, "text": "And down there, at the bottom of the sea,", "words": [{"w": "And", "s": 243.26, "e": 243.48}, {"w": "down", "s": 243.48, "e": 243.74}, {"w": "there,", "s": 243.74, "e": 244.12}, {"w": "at", "s": 244.38, "e": 244.62}, {"w": "the", "s": 244.62, "e": 244.76}, {"w": "bottom", "s": 244.76, "e": 244.98}, {"w": "of", "s": 244.98, "e": 245.2}, {"w": "the", "s": 245.2, "e": 245.32}, {"w": "sea,", "s": 245.32, "e": 245.6}]}, {"start": 246.1, "end": 247.9, "text": "there are cracks in the ocean floor", "words": [{"w": "there", "s": 246.1, "e": 246.42}, {"w": "are", "s": 246.42, "e": 246.56}, {"w": "cracks", "s": 246.56, "e": 246.84}, {"w": "in", "s": 246.84, "e": 247.08}, {"w": "the", "s": 247.08, "e": 247.18}, {"w": "ocean", "s": 247.18, "e": 247.52}, {"w": "floor", "s": 247.52, "e": 247.9}]}, {"start": 247.9, "end": 249.58, "text": "called hydrothermal vents.", "words": [{"w": "called", "s": 247.9, "e": 248.22}, {"w": "hydrothermal", "s": 248.22, "e": 249.18}, {"w": "vents.", "s": 249.18, "e": 249.58}]}, {"start": 250.0, "end": 252.12, "text": "Pouring out heat from inside the Earth.", "words": [{"w": "Pouring", "s": 250.0, "e": 250.36}, {"w": "out", "s": 250.36, "e": 250.6}, {"w": "heat", "s": 250.6, "e": 250.9}, {"w": "from", "s": 250.9, "e": 251.14}, {"w": "inside", "s": 251.14, "e": 251.68}, {"w": "the", "s": 251.68, "e": 251.92}, {"w": "Earth.", "s": 251.92, "e": 252.12}]}, {"start": 252.54, "end": 254.46, "text": "Whole communities of tiny living things", "words": [{"w": "Whole", "s": 252.54, "e": 252.74}, {"w": "communities", "s": 252.74, "e": 253.12}, {"w": "of", "s": 253.12, "e": 253.48}, {"w": "tiny", "s": 253.48, "e": 253.78}, {"w": "living", "s": 253.78, "e": 254.06}, {"w": "things", "s": 254.06, "e": 254.46}]}, {"start": 254.46, "end": 257.04, "text": "already live there without any sunlight at all.", "words": [{"w": "already", "s": 254.46, "e": 254.86}, {"w": "live", "s": 254.86, "e": 255.18}, {"w": "there", "s": 255.18, "e": 255.44}, {"w": "without", "s": 255.44, "e": 255.76}, {"w": "any", "s": 255.76, "e": 256.14}, {"w": "sunlight", "s": 256.14, "e": 256.54}, {"w": "at", "s": 256.54, "e": 256.76}, {"w": "all.", "s": 256.76, "e": 257.04}]}, {"start": 257.04, "end": 259.38, "text": "They won't even notice the sun is gone.", "words": [{"w": "They", "s": 257.04, "e": 257.62}, {"w": "won't", "s": 257.62, "e": 257.82}, {"w": "even", "s": 257.82, "e": 258.06}, {"w": "notice", "s": 258.06, "e": 258.38}, {"w": "the", "s": 258.38, "e": 258.64}, {"w": "sun", "s": 258.64, "e": 258.82}, {"w": "is", "s": 258.82, "e": 259.0}, {"w": "gone.", "s": 259.0, "e": 259.38}]}, {"start": 260.28, "end": 260.72, "text": "Year one.", "words": [{"w": "Year", "s": 260.28, "e": 260.28}, {"w": "one.", "s": 260.28, "e": 260.72}]}, {"start": 261.54, "end": 262.08, "text": "On the surface,", "words": [{"w": "On", "s": 261.54, "e": 261.56}, {"w": "the", "s": 261.56, "e": 261.72}, {"w": "surface,", "s": 261.72, "e": 262.08}]}, {"start": 262.32, "end": 265.2, "text": "the average temperature reaches about minus 73 degrees.", "words": [{"w": "the", "s": 262.32, "e": 262.36}, {"w": "average", "s": 262.36, "e": 262.66}, {"w": "temperature", "s": 262.66, "e": 263.06}, {"w": "reaches", "s": 263.06, "e": 263.4}, {"w": "about", "s": 263.4, "e": 263.74}, {"w": "minus", "s": 263.74, "e": 264.1}, {"w": "73", "s": 264.1, "e": 264.84}, {"w": "degrees.", "s": 264.84, "e": 265.2}]}, {"start": 266.06, "end": 267.6, "text": "The air is so cold and still", "words": [{"w": "The", "s": 266.06, "e": 266.2}, {"w": "air", "s": 266.2, "e": 266.34}, {"w": "is", "s": 266.34, "e": 266.5}, {"w": "so", "s": 266.5, "e": 266.76}, {"w": "cold", "s": 266.76, "e": 267.1}, {"w": "and", "s": 267.1, "e": 267.3}, {"w": "still", "s": 267.3, "e": 267.6}]}, {"start": 267.6, "end": 269.72, "text": "that it starts to feel like another planet.", "words": [{"w": "that", "s": 267.6, "e": 267.8}, {"w": "it", "s": 267.8, "e": 267.92}, {"w": "starts", "s": 267.92, "e": 268.2}, {"w": "to", "s": 268.2, "e": 268.48}, {"w": "feel", "s": 268.48, "e": 268.68}, {"w": "like", "s": 268.68, "e": 268.9}, {"w": "another", "s": 268.9, "e": 269.2}, {"w": "planet.", "s": 269.2, "e": 269.72}]}, {"start": 270.22, "end": 272.5, "text": "Because, in a way, it is.", "words": [{"w": "Because,", "s": 270.22, "e": 270.7}, {"w": "in", "s": 270.96, "e": 271.16}, {"w": "a", "s": 271.16, "e": 271.3}, {"w": "way,", "s": 271.3, "e": 271.64}, {"w": "it", "s": 271.94, "e": 272.1}, {"w": "is.", "s": 272.1, "e": 272.5}]}, {"start": 273.22, "end": 274.88, "text": "Earth is now a rogue planet,", "words": [{"w": "Earth", "s": 273.22, "e": 273.48}, {"w": "is", "s": 273.48, "e": 273.7}, {"w": "now", "s": 273.7, "e": 273.96}, {"w": "a", "s": 273.96, "e": 274.12}, {"w": "rogue", "s": 274.12, "e": 274.42}, {"w": "planet,", "s": 274.42, "e": 274.88}]}, {"start": 275.1, "end": 277.12, "text": "drifting through the dark between the stars.", "words": [{"w": "drifting", "s": 275.1, "e": 275.42}, {"w": "through", "s": 275.42, "e": 275.68}, {"w": "the", "s": 275.68, "e": 275.86}, {"w": "dark", "s": 275.86, "e": 276.14}, {"w": "between", "s": 276.14, "e": 276.54}, {"w": "the", "s": 276.54, "e": 276.74}, {"w": "stars.", "s": 276.74, "e": 277.12}]}, {"start": 277.74, "end": 278.58, "text": "So where is Milo?", "words": [{"w": "So", "s": 277.74, "e": 277.96}, {"w": "where", "s": 277.96, "e": 278.18}, {"w": "is", "s": 278.18, "e": 278.4}, {"w": "Milo?", "s": 278.4, "e": 278.58}]}, {"start": 279.1, "end": 279.86, "text": "If he's smart,", "words": [{"w": "If", "s": 279.1, "e": 279.34}, {"w": "he's", "s": 279.34, "e": 279.54}, {"w": "smart,", "s": 279.54, "e": 279.86}]}, {"start": 280.12, "end": 282.68, "text": "he's gone where the Earth still has heat of its own.", "words": [{"w": "he's", "s": 280.12, "e": 280.46}, {"w": "gone", "s": 280.46, "e": 280.66}, {"w": "where", "s": 280.66, "e": 280.84}, {"w": "the", "s": 280.84, "e": 280.96}, {"w": "Earth", "s": 280.96, "e": 281.22}, {"w": "still", "s": 281.22, "e": 281.62}, {"w": "has", "s": 281.62, "e": 281.86}, {"w": "heat", "s": 281.86, "e": 282.08}, {"w": "of", "s": 282.08, "e": 282.2}, {"w": "its", "s": 282.2, "e": 282.36}, {"w": "own.", "s": 282.36, "e": 282.68}]}, {"start": 282.94, "end": 284.9, "text": "Places with volcanoes and hot springs.", "words": [{"w": "Places", "s": 282.94, "e": 283.18}, {"w": "with", "s": 283.18, "e": 283.48}, {"w": "volcanoes", "s": 283.48, "e": 284.14}, {"w": "and", "s": 284.14, "e": 284.34}, {"w": "hot", "s": 284.34, "e": 284.56}, {"w": "springs.", "s": 284.56, "e": 284.9}]}, {"start": 284.9, "end": 287.38, "text": "Where heat rises from deep underground.", "words": [{"w": "Where", "s": 284.9, "e": 285.62}, {"w": "heat", "s": 285.62, "e": 285.9}, {"w": "rises", "s": 285.9, "e": 286.32}, {"w": "from", "s": 286.32, "e": 286.6}, {"w": "deep", "s": 286.6, "e": 286.86}, {"w": "underground.", "s": 286.86, "e": 287.38}]}, {"start": 288.24, "end": 291.02, "text": "With that heat, power, and food grown under lamps,", "words": [{"w": "With", "s": 288.24, "e": 288.36}, {"w": "that", "s": 288.36, "e": 288.6}, {"w": "heat,", "s": 288.6, "e": 288.86}, {"w": "power,", "s": 289.16, "e": 289.3}, {"w": "and", "s": 289.58, "e": 289.74}, {"w": "food", "s": 289.74, "e": 290.06}, {"w": "grown", "s": 290.06, "e": 290.38}, {"w": "under", "s": 290.38, "e": 290.68}, {"w": "lamps,", "s": 290.68, "e": 291.02}]}, {"start": 291.36, "end": 293.06, "text": "a small group of people could survive.", "words": [{"w": "a", "s": 291.36, "e": 291.54}, {"w": "small", "s": 291.54, "e": 291.8}, {"w": "group", "s": 291.8, "e": 292.0}, {"w": "of", "s": 292.0, "e": 292.16}, {"w": "people", "s": 292.16, "e": 292.36}, {"w": "could", "s": 292.36, "e": 292.62}, {"w": "survive.", "s": 292.62, "e": 293.06}]}, {"start": 293.46, "end": 294.26, "text": "Not live well.", "words": [{"w": "Not", "s": 293.46, "e": 293.74}, {"w": "live", "s": 293.74, "e": 293.96}, {"w": "well.", "s": 293.96, "e": 294.26}]}, {"start": 294.64, "end": 294.94, "text": "Survive.", "words": [{"w": "Survive.", "s": 294.64, "e": 294.94}]}, {"start": 295.58, "end": 297.18, "text": "Milo's final survival odds?", "words": [{"w": "Milo's", "s": 295.58, "e": 296.0}, {"w": "final", "s": 296.0, "e": 296.24}, {"w": "survival", "s": 296.24, "e": 296.72}, {"w": "odds?", "s": 296.72, "e": 297.18}]}, {"start": 297.58, "end": 298.3, "text": "Five percent.", "words": [{"w": "Five", "s": 297.58, "e": 297.82}, {"w": "percent.", "s": 297.82, "e": 298.3}]}, {"start": 298.68, "end": 299.8, "text": "Unless he moved fast.", "words": [{"w": "Unless", "s": 298.68, "e": 298.98}, {"w": "he", "s": 298.98, "e": 299.14}, {"w": "moved", "s": 299.14, "e": 299.36}, {"w": "fast.", "s": 299.36, "e": 299.8}]}, {"start": 300.2, "end": 301.28, "text": "In the first eight minutes", "words": [{"w": "In", "s": 300.2, "e": 300.32}, {"w": "the", "s": 300.32, "e": 300.46}, {"w": "first", "s": 300.46, "e": 300.68}, {"w": "eight", "s": 300.68, "e": 300.9}, {"w": "minutes", "s": 300.9, "e": 301.28}]}, {"start": 301.28, "end": 303.5, "text": "while the rest of the world was still eating lunch.", "words": [{"w": "while", "s": 301.28, "e": 301.56}, {"w": "the", "s": 301.56, "e": 301.7}, {"w": "rest", "s": 301.7, "e": 301.88}, {"w": "of", "s": 301.88, "e": 302.08}, {"w": "the", "s": 302.08, "e": 302.18}, {"w": "world", "s": 302.18, "e": 302.38}, {"w": "was", "s": 302.38, "e": 302.62}, {"w": "still", "s": 302.62, "e": 302.9}, {"w": "eating", "s": 302.9, "e": 303.16}, {"w": "lunch.", "s": 303.16, "e": 303.5}]}, {"start": 304.26, "end": 305.2, "text": "So let me ask you.", "words": [{"w": "So", "s": 304.26, "e": 304.48}, {"w": "let", "s": 304.48, "e": 304.62}, {"w": "me", "s": 304.62, "e": 304.72}, {"w": "ask", "s": 304.72, "e": 304.98}, {"w": "you.", "s": 304.98, "e": 305.2}]}, {"start": 305.44, "end": 307.12, "text": "If you knew the sun had disappeared", "words": [{"w": "If", "s": 305.44, "e": 305.64}, {"w": "you", "s": 305.64, "e": 305.84}, {"w": "knew", "s": 305.84, "e": 306.0}, {"w": "the", "s": 306.0, "e": 306.2}, {"w": "sun", "s": 306.2, "e": 306.4}, {"w": "had", "s": 306.4, "e": 306.58}, {"w": "disappeared", "s": 306.58, "e": 307.12}]}, {"start": 307.12, "end": 310.42, "text": "and you had eight minutes before anyone else found out,", "words": [{"w": "and", "s": 307.12, "e": 307.7}, {"w": "you", "s": 307.7, "e": 307.86}, {"w": "had", "s": 307.86, "e": 308.06}, {"w": "eight", "s": 308.06, "e": 308.36}, {"w": "minutes", "s": 308.36, "e": 308.72}, {"w": "before", "s": 308.72, "e": 309.08}, {"w": "anyone", "s": 309.08, "e": 309.48}, {"w": "else", "s": 309.48, "e": 309.76}, {"w": "found", "s": 309.76, "e": 310.02}, {"w": "out,", "s": 310.02, "e": 310.42}]}, {"start": 310.78, "end": 311.7, "text": "where would you go?", "words": [{"w": "where", "s": 310.78, "e": 311.08}, {"w": "would", "s": 311.08, "e": 311.24}, {"w": "you", "s": 311.24, "e": 311.38}, {"w": "go?", "s": 311.38, "e": 311.7}]}, {"start": 312.14, "end": 312.96, "text": "Tell me in the comments.", "words": [{"w": "Tell", "s": 312.14, "e": 312.3}, {"w": "me", "s": 312.3, "e": 312.42}, {"w": "in", "s": 312.42, "e": 312.52}, {"w": "the", "s": 312.52, "e": 312.66}, {"w": "comments.", "s": 312.66, "e": 312.96}]}, {"start": 313.76, "end": 316.82, "text": "And next time, Milo falls into a black hole.", "words": [{"w": "And", "s": 313.75, "e": 314.02}, {"w": "next", "s": 314.02, "e": 314.3}, {"w": "time,", "s": 314.3, "e": 314.74}, {"w": "Milo", "s": 315.26, "e": 315.34}, {"w": "falls", "s": 315.34, "e": 315.76}, {"w": "into", "s": 315.76, "e": 316.04}, {"w": "a", "s": 316.04, "e": 316.26}, {"w": "black", "s": 316.26, "e": 316.48}, {"w": "hole.", "s": 316.48, "e": 316.82}]}, {"start": 317.42, "end": 318.3, "text": "He has one hour.", "words": [{"w": "He", "s": 317.42, "e": 317.54}, {"w": "has", "s": 317.54, "e": 317.68}, {"w": "one", "s": 317.68, "e": 317.94}, {"w": "hour.", "s": 317.94, "e": 318.3}]}, {"start": 318.82, "end": 319.34, "text": "See you there.", "words": [{"w": "See", "s": 318.82, "e": 318.98}, {"w": "you", "s": 318.98, "e": 319.1}, {"w": "there.", "s": 319.1, "e": 319.34}]}]